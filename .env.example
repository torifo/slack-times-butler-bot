SLACK_SIGNING_SECRET=replace-with-signing-secret
SLACK_BOT_TOKEN=replace-with-bot-token
SLACK_APP_TOKEN=replace-with-app-token

SOURCE_CHANNEL=C0123456789
SOURCE_CHANNEL_NAME=
POST_TARGET_CHANNEL=C0123456789
WEEKLY_SUMMARY_CANVAS_ID=

# claude_gateway か japan_ai。claude_gateway は失敗時に JAPAN AI へフォールバックする
LLM_BACKEND=japan_ai
LLM_GATEWAY_URL=http://127.0.0.1:8100
LLM_GATEWAY_URL_BACKUP=http://127.0.0.1:8101
LLM_GATEWAY_TIMEOUT_SECONDS=180.0

JAPAN_AI_API_KEY=replace-with-api-key
JAPAN_AI_BASE_URL=https://api.japan-ai.co.jp
JAPAN_AI_MODEL=gpt-4o
JAPAN_AI_USER_ID=
JAPAN_AI_ARTIFACT_IDS=
JAPAN_AI_CHAT_ENDPOINT=/chat/v2
JAPAN_AI_TEMPERATURE=0.1
REQUEST_TIMEOUT_SECONDS=20.0

DATABASE_PATH=data/times_butler.sqlite3
DAILY_DIGEST_CRON=30 18 * * *
WEEKLY_DIGEST_CRON=0 19 * * FRI
DEFAULT_EXPLANATION_LEVEL=2
URL_REACTION_NAME=eyes
