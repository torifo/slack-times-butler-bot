[Unit]
Description=times-Butler FastAPI service
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/times_butler
EnvironmentFile=/opt/times_butler/.env
ExecStart=/opt/times_butler/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
